{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/plugins/task-queue/skills/task-queue/scripts/tq.mjs\" hook session-start --host gemini",
            "timeout": 20000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/plugins/task-queue/skills/task-queue/scripts/tq.mjs\" hook prompt --host gemini",
            "timeout": 20000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/plugins/task-queue/skills/task-queue/scripts/tq.mjs\" hook stop --host gemini",
            "timeout": 20000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/plugins/task-queue/skills/task-queue/scripts/tq.mjs\" hook session-end --host gemini",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
