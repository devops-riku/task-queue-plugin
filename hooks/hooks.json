{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/skills/task-queue/scripts/tq.mjs", "hook", "session-start"], "timeout": 20 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/skills/task-queue/scripts/tq.mjs", "hook", "prompt"], "timeout": 20 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/skills/task-queue/scripts/tq.mjs", "hook", "stop"], "timeout": 20 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/skills/task-queue/scripts/tq.mjs", "hook", "session-end"], "timeout": 20 }
        ]
      }
    ]
  }
}
