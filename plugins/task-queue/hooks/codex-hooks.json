{
  "description": "Task Queue tracking for Codex: briefs the agent on each prompt, approves its own tracker command and closes what it leaves open.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/skills/task-queue/scripts/tq.mjs\" hook session-start --host codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\task-queue\\scripts\\tq.mjs\" hook session-start --host codex",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/skills/task-queue/scripts/tq.mjs\" hook prompt --host codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\task-queue\\scripts\\tq.mjs\" hook prompt --host codex",
            "timeout": 20
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/skills/task-queue/scripts/tq.mjs\" hook approve --host codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\task-queue\\scripts\\tq.mjs\" hook approve --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/skills/task-queue/scripts/tq.mjs\" hook stop --host codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\task-queue\\scripts\\tq.mjs\" hook stop --host codex",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/skills/task-queue/scripts/tq.mjs\" hook session-end --host codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\task-queue\\scripts\\tq.mjs\" hook session-end --host codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
